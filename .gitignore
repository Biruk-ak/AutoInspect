# AutoInspect .gitignore
# Comprehensive ignore rules for Node/TypeScript monorepo (Next.js + NestJS + Docker)

# --- Dependencies ---
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/versions

# --- Builds / outputs ---
dist/
build/
out/
.next/
.nuxt/
.turbo/
.cache/
*.tsbuildinfo
*.esm.js.map
*.cjs.js.map

# --- Coverage / tests ---
coverage/
.nyc_output/
*.lcov
jest-results/
test-results/
playwright-report/
blob-report/

# --- Environment & secrets (NEVER commit) ---
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json
auth.json
.npmrc
!.npmrc.example

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OS files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors / IDEs ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# --- Cursor / local AI tooling ---
.cursor/
.cursorignore
*.canvas.tsx.local

# --- Docker / local runtime ---
docker-data/
pgdata/
*.pid
*.seed

# --- Temporary files ---
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
.sass-cache/

# --- Python helper scripts (if used locally) ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
ENV/

# --- Package manager locks (optional: keep package-lock.json tracked) ---
# Uncomment if you intentionally omit lockfiles:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# --- Misc generated ---
*.tgz
.eslintcache
.stylelintcache
.prettiercache
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
